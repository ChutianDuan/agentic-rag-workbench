MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_app
MYSQL_USER=ai_user
MYSQL_PASSWORD=ai_password
# Optional. Use these when the app user does not already exist or cannot create databases.
MYSQL_ADMIN_USER=
MYSQL_ADMIN_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Python runtime environment names used by startup scripts.
# API/worker use RAG_API_ENV. Local vLLM is optional and only starts when
# LLM_RUNTIME=local_vllm is set explicitly.
RAG_API_ENV=rag-api
RAG_API_VENV=./.venv
VLLM_ENV=vllm-qwen3
VLLM_VENV=

# Local stack manager (scripts/start_all.sh).
START_FRONTEND=false
START_GATEWAY=true
START_INIT_DB=false
START_WAIT_SECONDS=20
STOP_WAIT_SECONDS=8
FRONTEND_PORT=5173
LOG_LINES=80
FOLLOW_LOGS=false
# Optional client-facing health check URLs. Empty values are inferred from listen ports.
# PYTHON_BASE_URL=http://127.0.0.1:8000
# GATEWAY_BASE_URL=http://127.0.0.1:8080
# FRONTEND_BASE_URL=http://127.0.0.1:5173

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_POOL=threads
CELERY_CONCURRENCY=4

APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# C++ Gateway runtime. Defaults reuse MYSQL_*, REDIS_* and APP_PORT where possible.
GATEWAY_LISTEN_HOST=0.0.0.0
GATEWAY_LISTEN_PORT=8080
GATEWAY_THREADS=4
GATEWAY_MYSQL_CONNECTIONS=1
GATEWAY_MYSQL_TIMEOUT_SECONDS=-1
GATEWAY_REDIS_CONNECTIONS=1
GATEWAY_REDIS_TIMEOUT_SECONDS=-1
GATEWAY_CLIENT_MAX_BODY_SIZE=100M

# C++ Gateway security. Comma-separated values support raw keys or name=secret pairs.
GATEWAY_AUTH_ENABLED=
GATEWAY_API_KEYS=
GATEWAY_API_KEY_HEADER=X-API-Key
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_IP_LIMIT=120
GATEWAY_RATE_LIMIT_USER_LIMIT=60
GATEWAY_RATE_LIMIT_FAIL_OPEN=false
GATEWAY_RATE_LIMIT_REDIS_PREFIX=rag_gateway:rate_limit
GATEWAY_TRUST_X_FORWARDED_FOR=false
GATEWAY_MAX_STREAMS=64
GATEWAY_SSE_CONNECT_TIMEOUT_SECONDS=10
GATEWAY_SSE_UPSTREAM_IDLE_TIMEOUT_SECONDS=120
GATEWAY_SSE_UPSTREAM_LOW_SPEED_BYTES=1
GATEWAY_SSE_CURL_BUFFER_BYTES=1024
GATEWAY_SSE_EMIT_GATEWAY_METRICS=true

STORAGE_ROOT=./data
UPLOAD_DIR=./data/uploads
MAX_DOCUMENT_SIZE_BYTES=104857600
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=100

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "
EMBEDDING_DOCUMENT_PREFIX=

# Optional. Applies only to Python API/worker startup scripts, not vLLM.
# Use *_DISABLE_CUDA=true when embedding/rerank should stay on CPU even if CUDA exists.
# Use *_CUDA_VISIBLE_DEVICES=6 to bind Python embedding/rerank to a specific physical GPU.
# Process-specific API_* and WORKER_* override the shared PYTHON_* defaults.
# PYTHON_DISABLE_CUDA=
# PYTHON_CUDA_VISIBLE_DEVICES=
# API_DISABLE_CUDA=
# API_CUDA_VISIBLE_DEVICES=
# WORKER_DISABLE_CUDA=
# WORKER_CUDA_VISIBLE_DEVICES=

RERANK_ENABLE=true
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_DEVICE=auto
RERANK_BATCH_SIZE=16
RERANK_LOCAL_FILES_ONLY=false
RERANK_CACHE_DIR=
RERANK_DOWNLOAD_IF_MISSING=true
RERANK_FALLBACK_TO_FAISS=true
RETRIEVAL_RECALL_PROVIDER=lancedb
VECTOR_STORE_PROVIDER=lancedb
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=chunk_vectors
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_RERANK_TOP_K=5
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# LLM runtime. Default uses a remote OpenAI-compatible API.
# Set LLM_RUNTIME=local_vllm only when you intentionally start a local vLLM server.
LLM_RUNTIME=api

# Optional local vLLM startup helper variables. Ignored in API mode.
VLLM_MODEL_PATH=
VLLM_SERVED_MODEL_NAME=
VLLM_HOST=0.0.0.0
VLLM_PORT=9000
VLLM_API_KEY=
VLLM_CUDA_VISIBLE_DEVICES=
VLLM_DTYPE=auto
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=

LLM_ENABLE=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MIMO_API_KEY=
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=512
LLM_TOKEN_LIMIT_FIELD=max_tokens
LLM_MAX_GENERATION_ROUNDS=3
LLM_TEMPERATURE=0.2
LLM_TOP_P=
LLM_FREQUENCY_PENALTY=
LLM_PRESENCE_PENALTY=
# Agent routing: explicitly set a lightweight model; blank model uses Agent fallback.
# Blank connection settings inherit the corresponding LLM_* settings.
ROUTER_LLM_MODEL=
ROUTER_LLM_BASE_URL=
ROUTER_LLM_API_KEY=
ROUTER_LLM_TIMEOUT_SECONDS=5
ROUTER_LLM_MAX_TOKENS=96
ROUTER_LLM_TOKEN_LIMIT_FIELD=
LLM_PROMPT_COST_PER_1K_TOKENS=0
LLM_COMPLETION_COST_PER_1K_TOKENS=0
EMBEDDING_COST_PER_1K_TOKENS=0
CHAT_TOP_K=5
CHAT_CANDIDATE_TOP_K=50
CHAT_MIN_RETRIEVAL_SCORE=0.0
CHAT_MAX_CHUNK_CHARS=1000
RETRIEVAL_CONTEXT_WINDOW=1
RETRIEVAL_CONTEXT_MAX_CHARS=3000
STREAM_DELTA_CHARS=20
STREAM_MOCK_DELAY_MS=30
CHAT_ENABLE_MOCK_FALLBACK=true
MONITOR_METRICS_WINDOW_SECONDS=300
MONITOR_METRICS_MAX_ROWS=5000
# Optional. Empty means infer from VLLM/API/WORKER/PYTHON *_CUDA_VISIBLE_DEVICES; use all to show every GPU.
MONITOR_GPU_IDS=
